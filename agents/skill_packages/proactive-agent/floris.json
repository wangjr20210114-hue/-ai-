{
  "schema_version": 2,
  "id": "proactive-agent",
  "version": "1.0.0",
  "kind": "system",
  "publisher": {"id": "floris", "name": "Floris", "verified": true},
  "required_plan": "guest",
  "order": 5,
  "default_enabled": true,
  "locked": true,
  "capabilities": ["workflow_action"],
  "plan_flags": ["needs_workflow_action"],
  "tools": [{"name": "propose_workflow", "capability": "workflow_action"}],
  "adapter": "agents._skill_adapters.proactive_agent.adapter:build_tools",
  "preference_hook": "agents._skill_adapters.proactive_agent.adapter:on_preference_changed",
  "recommends": ["calendar", "maps"],
  "permissions": ["makers.state", "makers.trace", "conversation.read", "user.read", "components.chat", "components.workspace"],
  "component_actions": ["chat.progress.publish", "workspace.action.propose", "workspace.state.read"],
  "ui": {
    "icon": "✦",
    "name": {"zh-CN": "主动式 Agent", "zh-TW": "主動式 Agent", "en": "Proactive Agent"},
    "description": {"zh-CN": "根据日程、天气、路线与工作流主动发现机会并提醒。", "zh-TW": "根據日程、天氣、路線與工作流主動發現機會並提醒。", "en": "Discover opportunities and remind based on schedules, routes, and workflows."}
  },
  "planner": {
    "topic": "proactive",
    "summary": "Recurring, scheduled or multi-step workflows and proactive follow-up.",
    "recovery_tools": ["propose_workflow"]
  }
}
