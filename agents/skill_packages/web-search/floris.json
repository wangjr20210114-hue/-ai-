{
  "schema_version": 2,
  "id": "web-search",
  "version": "1.0.0",
  "kind": "system",
  "publisher": {"id": "floris", "name": "Floris", "verified": true},
  "required_plan": "free",
  "order": 10,
  "category": "knowledge",
  "default_enabled": true,
  "capabilities": ["web_search"],
  "plan_flags": ["needs_web_search"],
  "tools": [
    {"name": "rich_search", "capability": "web_search", "publishes": ["search.evidence.publish", "search.media.publish"]},
    {"name": "collect_page_images", "capability": "web_search", "required": false}
  ],
  "adapter": "agents._skill_adapters.web_search.adapter:build_tools",
  "permissions": ["makers.state", "makers.trace", "conversation.read", "user.read", "components.search"],
  "component_actions": ["search.evidence.publish", "search.media.publish"],
  "ui": {
    "icon": "◎",
    "name": {"zh-CN": "实时搜索", "zh-TW": "即時搜尋", "en": "Live search"},
    "description": {"zh-CN": "检索时效信息、核验来源并提供真实图片素材。", "zh-TW": "檢索即時資訊、核驗來源並提供真實圖片素材。", "en": "Find timely information, verify sources, and provide real image material."}
  },
  "planner": {
    "topic": "web",
    "summary": "Current external facts, verification, sources, news, prices and public web media.",
    "recovery_tools": ["rich_search"]
  }
}
