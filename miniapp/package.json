{
  "name": "floris-wechat-miniapp",
  "version": "0.5.0",
  "private": true,
  "description": "Floris 微信小程序客户端",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:weapp:preview": "taro build --type weapp --mode development",
    "assets:tabs": "node scripts/generate-tab-icons.mjs",
    "dev:weapp": "taro build --type weapp --watch",
    "preflight": "node scripts/preflight.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@floris/contracts": "file:../packages/floris-contracts",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "fast-text-encoding": "^1.0.6",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-react": "^7.28.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.24",
    "babel-preset-taro": "4.2.1",
    "miniprogram-api-typings": "^4.0.2",
    "miniprogram-automator": "^0.12.1",
    "pngjs": "^3.4.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10",
    "webpack": "5.91.0"
  }
}
