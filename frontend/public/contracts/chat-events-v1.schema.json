{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floris-dev.jlutx.com/contracts/chat-events-v1.schema.json",
  "title": "Floris Client SSE Event v1",
  "description": "Versioned streaming events shared by chat, paper reader and image studio clients.",
  "anyOf": [
    { "$ref": "#/$defs/aiResponse" },
    { "$ref": "#/$defs/aiResponseReset" },
    { "$ref": "#/$defs/toolActivity" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/searchResults" },
    { "$ref": "#/$defs/searchMedia" },
    { "$ref": "#/$defs/paperResults" },
    { "$ref": "#/$defs/workspaceAction" },
    { "$ref": "#/$defs/clarification" },
    { "$ref": "#/$defs/browserLocationRequest" },
    { "$ref": "#/$defs/experienceHint" },
    { "$ref": "#/$defs/answerComplete" },
    { "$ref": "#/$defs/followUps" },
    { "$ref": "#/$defs/proactiveUpdate" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/paperDelta" },
    { "$ref": "#/$defs/paperDone" },
    { "$ref": "#/$defs/imageProgress" },
    { "$ref": "#/$defs/imageAction" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/openEvent" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string" } },
      "additionalProperties": true
    },
    "aiResponse": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "ai_response" }, "content": { "type": "string" } }, "required": ["content"] }
      ]
    },
    "aiResponseReset": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "ai_response_reset" } } }
      ]
    },
    "toolActivity": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "enum": ["tool_call", "tool_result"] },
            "name": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["name"]
        }
      ]
    },
    "progress": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "progress_event" }, "payload": { "$ref": "floris-components-v1.schema.json#/$defs/progress" } }, "required": ["payload"] }
      ]
    },
    "searchResults": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "search_results" }, "payload": { "$ref": "floris-components-v1.schema.json#/$defs/searchMeta" } }, "required": ["payload"] }
      ]
    },
    "searchMedia": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "search_media" }, "payload": { "$ref": "floris-components-v1.schema.json#/$defs/searchMeta" } }, "required": ["payload"] }
      ]
    },
    "paperResults": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "paper_results" }, "payload": { "$ref": "floris-components-v1.schema.json#/$defs/paperResults" } }, "required": ["payload"] }
      ]
    },
    "workspaceAction": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "enum": ["map_action", "calendar_action", "side_effect_action"] }, "payload": { "type": "object", "required": ["action"], "properties": { "action": { "$ref": "floris-components-v1.schema.json#/$defs/workspaceAction" }, "component_api": { "$ref": "floris-components-v1.schema.json#/$defs/componentPublicationBatch" } }, "additionalProperties": true } }, "required": ["payload"] }
      ]
    },
    "clarification": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "clarification_action" }, "payload": { "type": "object", "required": ["clarification"], "properties": { "clarification": { "$ref": "floris-components-v1.schema.json#/$defs/clarification" }, "component_api": { "$ref": "floris-components-v1.schema.json#/$defs/componentPublicationBatch" } } } }, "required": ["payload"] }
      ]
    },
    "browserLocationRequest": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "browser_location_request" },
            "payload": {
              "type": "object",
              "required": ["reason"],
              "properties": { "reason": { "type": "string" } },
              "additionalProperties": true
            }
          },
          "required": ["payload"]
        }
      ]
    },
    "experienceHint": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "experience_hint" },
            "payload": {
              "type": "object",
              "required": ["schema_version", "items"],
              "properties": {
                "schema_version": { "const": 1 },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "skill_ids"],
                    "properties": {
                      "kind": { "enum": ["freshness", "skill_suggestion"] },
                      "skill_ids": { "type": "array", "items": { "type": "string" } },
                      "login_required": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          },
          "required": ["payload"]
        }
      ]
    },
    "answerComplete": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "answer_complete" },
            "payload": {
              "type": "object",
              "properties": { "turn_id": { "type": "string" } },
              "additionalProperties": true
            }
          }
        }
      ]
    },
    "followUps": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "follow_ups" },
            "payload": {
              "type": "object",
              "required": ["items"],
              "properties": { "items": { "type": "array", "items": { "type": "string" } } }
            }
          },
          "required": ["payload"]
        }
      ]
    },
    "proactiveUpdate": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "proactive_update" }, "payload": { "type": "object", "additionalProperties": true } }, "required": ["payload"] }
      ]
    },
    "usage": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "usage" },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          },
          "required": ["input_tokens", "output_tokens", "total_tokens"]
        }
      ]
    },
    "paperDelta": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "paper_delta" },
            "content": { "type": "string" }
          },
          "required": ["content"]
        }
      ]
    },
    "paperDone": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "paper_done" } } }
      ]
    },
    "imageProgress": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "image_progress" },
            "stage": { "enum": ["preparing", "retrying_blob"] }
          },
          "required": ["stage"]
        }
      ]
    },
    "imageAction": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "image_action" },
            "action": { "$ref": "floris-components-v1.schema.json#/$defs/workspaceAction" }
          },
          "required": ["action"]
        }
      ]
    },
    "ping": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "ping" }, "ts": { "type": "integer" } }, "required": ["ts"] }
      ]
    },
    "error": {
      "allOf": [{ "$ref": "#/$defs/base" }, { "properties": { "type": { "const": "error_message" }, "code": { "type": "string" }, "content": { "type": "string" } }, "required": ["code", "content"] }]
    },
    "openEvent": {
      "description": "Forward-compatible event. v1 clients ignore unknown type values.",
      "$ref": "#/$defs/base"
    }
  }
}
